{
  "name": "vix-voice-preview",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/signal/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "USERS", "class_name": "Users" },
      { "name": "SERVERS", "class_name": "Servers" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Users", "Servers"] }
  ]
}
