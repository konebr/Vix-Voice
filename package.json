{
  "name": "vix-voice",
  "version": "1.2.0-beta.3",
  "description": "Vix Voice é um aplicativo de comunidades, texto e voz.",
  "author": "Vix Voice",
  "private": true,
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "wrangler dev --no-bundle --config wrangler.preview.jsonc --ip 0.0.0.0 --port 8787 --persist-to .wrangler/state",
    "backup": "node scripts/backup.cjs",
    "start": "node server.js",
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.vixvoice.desktop",
    "productName": "Vix Voice",
    "artifactName": "Vix-Voice-Setup-${version}.${ext}",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://app.vix-voice.com.br/download/"
      }
    ],
    "asar": true,
    "files": [
      "electron-main.cjs",
      "package.json",
      "build/icon.png"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "livekit-client": "^2.22.3"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "localtunnel": "^2.0.2",
    "wrangler": "^4.129.0",
    "ws": "^8.21.3"
  }
}
