{
  "name": "vox-voice",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/signal/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "USERS", "class_name": "Users" },
      { "name": "SERVERS", "class_name": "Servers" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Users"] },
    { "tag": "v3", "new_sqlite_classes": ["Servers"] }
  ]
}
