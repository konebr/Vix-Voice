[Unit]
Description=Vix Voice Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vixvoice
WorkingDirectory=/opt/vix-voice/app
Environment=WRANGLER_SEND_METRICS=false
EnvironmentFile=-/etc/vix-voice/email.env
ExecStart=/usr/bin/wrangler dev --no-bundle --config wrangler.preview.jsonc --ip 127.0.0.1 --port 8787 --persist-to /opt/vix-voice/app/.wrangler/state --log-level error
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
